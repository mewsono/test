<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure black window so there is never a grey flash before Compose draws. -->
    <style name="Theme.Obsidian" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian_black</item>
        <item name="android:colorBackground">@color/obsidian_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
